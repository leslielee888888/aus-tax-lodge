{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@aus-tax-lodge/engine": ["packages/engine/src/index.ts"],
      "@aus-tax-lodge/engine/*": ["packages/engine/src/*"],
      "@aus-tax-lodge/config": ["packages/config/src/index.ts"],
      "@aus-tax-lodge/config/*": ["packages/config/src/*"],
      "@aus-tax-lodge/params": ["packages/params/src/index.ts"],
      "@aus-tax-lodge/params/*": ["packages/params/src/*"]
    }
  }
}
