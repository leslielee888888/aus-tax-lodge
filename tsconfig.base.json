{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@aus-tax-lodge/ai": ["packages/ai/src/index.ts"],
      "@aus-tax-lodge/ai/*": ["packages/ai/src/*"],
      "@aus-tax-lodge/config": ["packages/config/src/index.ts"],
      "@aus-tax-lodge/config/*": ["packages/config/src/*"],
      "@aus-tax-lodge/engine": ["packages/engine/src/index.ts"],
      "@aus-tax-lodge/engine/*": ["packages/engine/src/*"],
      "@aus-tax-lodge/export": ["packages/export/src/index.ts"],
      "@aus-tax-lodge/export/*": ["packages/export/src/*"],
      "@aus-tax-lodge/extraction": ["packages/extraction/src/index.ts"],
      "@aus-tax-lodge/extraction/*": ["packages/extraction/src/*"],
      "@aus-tax-lodge/model": ["packages/model/src/index.ts"],
      "@aus-tax-lodge/model/*": ["packages/model/src/*"],
      "@aus-tax-lodge/params": ["packages/params/src/index.ts"],
      "@aus-tax-lodge/params/*": ["packages/params/src/*"],
      "@aus-tax-lodge/store": ["packages/store/src/index.ts"],
      "@aus-tax-lodge/store/*": ["packages/store/src/*"]
    }
  }
}
